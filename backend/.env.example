# ─── Core (Railway API service) ─────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Railway injects this when you link the Postgres plugin — paste it here locally
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway
# Set false only for local Postgres without SSL
DATABASE_SSL=true
DB_POOL_MAX=10

# Long random string (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
# Desk admin password (phone login: admin)
RAPYD_ADMIN_PASSWORD=change-me
# NEVER true in production
EXPOSE_OTP=false

# ─── Redis (Railway Redis plugin — recommended for queues) ──────────────────
# Without REDIS_URL, jobs still run in-process memory (single instance only)
REDIS_URL=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Rapyd Ryd <noreply@rapydryd.com>

# ─── Dojah — NIN + face (server only; never EXPO_PUBLIC_*) ──────────────────
# Dashboard → Developers → Configuration
# Sandbox: https://sandbox.dojah.io  · Live: https://api.dojah.io
# Authorization header = secret key as-is (do NOT prefix Bearer)
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io
# Face match cutoff 50–100 (Dojah default 90)
DOJAH_FACE_THRESHOLD=90
# 1:N face search threshold 0–1 (default 0.75) — blocks same face on two accounts
DOJAH_FACE_SEARCH_THRESHOLD=0.75
# Optional pin for the Dojah face collection (auto-created once if empty)
DOJAH_FACE_COLLECTION_ID=
# Optional pepper for NIN hashes (defaults to JWT_SECRET)
DOJAH_NIN_PEPPER=
# Force selfie even in development: true | false (default: required only in production)
# DOJAH_REQUIRE_SELFIE=false

# ─── Google — server (keep these secret; never EXPO_PUBLIC_*) ───────────────
# Places / Maps server key — restrict by API (Places API, Maps) + IP if possible
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
# OAuth client IDs for Sign-In token verify (Web + iOS + Android)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ─── CORS / public URL (optional) ───────────────────────────────────────────
# PUBLIC_API_URL=https://backend-production-f8f5704e.up.railway.app
